# Copy to ../local-config/device.env (gitignored). Never commit the copy.
# Q10_DEVICE_PASSWORD=ask-me-in-person
# Q10_DEVICE_IP=169.254.0.1
# Q10_SSH_KEY=/Users/you/.ssh/q10-usb
# Same-Wi-Fi hub and remote mailbox (also local-config/mailbox.url + mailbox.token):
# Q10_LAN_HUB_URL=http://192.168.1.10:8787/snapshot.json
# Q10_MAILBOX_URL=https://q10-lab-mailbox.example.workers.dev/snapshot.json
# Q10_MAILBOX_TOKEN_FILE=/absolute/path/local-config/mailbox.token
# Hub 发现（与 Aindle AINDLE_PORT 对齐；8790 只作回退，不要在本仓库另起 Hub）：
# AINDLE_PORT=8787
# Q10_HUB_PORTS=8787,8790
# Q10_MONITOR_URL=
